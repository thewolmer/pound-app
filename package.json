{
  "name": "pound-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "dev:dev-client": "expo start -c --dev-client",
    "dev:android": "expo start -c --android",
    "dev:ios": "expo start -c --ios",
    "dev:web": "expo start -c --web",
    "build:development:android": "eas build --platform android --profile development --local --output build/android.development.apk",
    "build:staging:android": "eas build --platform android --profile staging --local --output build/android.staging.apk",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "clean": "rm -rf .expo node_modules",
    "postinstall": "npx tailwindcss -i ./global.css -o ./node_modules/.cache/nativewind/global.css",
    "lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "lint:fix": "biome check --no-errors-on-unmatched --files-ignore-unknown=true --write",
    "commit": "git-cz",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@rn-primitives/avatar": "~1.0.6",
    "@rn-primitives/portal": "~1.0.5",
    "@rn-primitives/slot": "~1.0.5",
    "@rn-primitives/types": "~1.0.5",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv-cli": "^7.4.2",
    "expo": "~51.0.38",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.28",
    "expo-font": "~12.0.10",
    "expo-linking": "~6.3.1",
    "expo-navigation-bar": "~3.0.7",
    "expo-router": "~3.5.23",
    "expo-splash-screen": "~0.27.6",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "expo-web-browser": "~13.0.3",
    "nativewind": "^4.0.33",
    "postgres": "^3.4.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-qrcode-svg": "^6.3.12",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.12",
    "tailwind-merge": "^2.5.3",
    "tailwindcss": "3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.8",
    "@biomejs/biome": "1.9.3",
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.2",
    "commit-and-tag-version": "^12.5.0",
    "cz-conventional-changelog": "^3.3.0",
    "typescript": "~5.3.3"
  },
  "private": true
}
