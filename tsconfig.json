{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"jsx": "react-native",
		"baseUrl": ".",
		"paths": {
			"~/*": ["*"]
		},
		"esModuleInterop": true,
		"checkJs": true
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
